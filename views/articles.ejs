<div class="container">
  <div class="left-rect" id="quotesContainer" data-search-item="true">
    <h2 style="color: #ffda79;">Quotes of the Day</h2>
    <blockquote>“The only way to deal with an unfree world is to become so absolutely free that your very existence is an act of rebellion.” <cite>— Albert Camus</cite></blockquote>
    <br/>
    <blockquote>“I can be changed by what happens to me. But I refuse to be reduced by it.” <cite>— Maya Angelou</cite></blockquote>
    <br/>
    <blockquote>“There is no greater agony than bearing an untold story inside you.” <cite>— Maya Angelou</cite></blockquote>
  </div>

  <div class="right-grid" id="articlesContainer">
    <% if (typeof communityArticles !== 'undefined' && communityArticles.length > 0) { %>
      <% communityArticles.forEach(function(article) { %>
        <div class="content-card" data-search-item="true">
          <h2><%= article.title %></h2>
          <span class="tag" style="background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-size: 0.8em; margin-bottom: 8px; display: inline-block;">
            <%= article.tag %>
          </span>
          <p class="meta" style="font-size: 0.9em; color: #bbb; margin-bottom: 10px;">By <%= article.author && article.author.name ? article.author.name : 'Unknown' %> &bull; <%= article.readTime %></p>
          <p class="excerpt" style="font-size: 0.95em;"><%= article.excerpt %></p>
          
          <div class="cta" style="margin-top: 20px; display: flex; align-items: center; justify-content: space-between;">
            <a href="#" style="background: rgba(255, 255, 255, 0.1); padding: 6px 12px; border-radius: 6px;">Read More</a>
            
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <form action="/articles/<%= article._id %>/bookmark" method="POST" style="margin:0;">
                <button type="submit" class="subscribe" style="border: 1px solid #ffda79; <%= userBookmarks && userBookmarks.includes(article._id.toString()) ? 'background: #ffda79; color: #111;' : 'background: transparent; color: #ffda79;' %> cursor: pointer; padding: 6px 12px; border-radius: 6px; font-weight: bold; transition: all 0.2s;">
                  <%= userBookmarks && userBookmarks.includes(article._id.toString()) ? '★ Bookmarked' : '☆ Bookmark' %>
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div style="grid-column: 1 / -1;">
        <p style="color:#fff;" data-search-item="true">No articles found in the archive. Log in to write one!</p>
      </div>
    <% } %>
  </div>
</div>
